algoritmo "Valor_de_Delta"
var
      A , B , C, Delta: REAL
inicio
       Escreva("Escreva um valor para A ")
       Leia (A)
       Escreva("Escreva um valor para B ")
       Leia (B)
       Escreva("Escreva um valor para C ")
       Leia (C)
       delta <- (b^2) - ( 4*a*c)
       Escreval("O valor de Delta é: ", delta)
fimalgoritmo